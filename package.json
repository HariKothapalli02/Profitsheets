{
  "name": "profitsheets-monorepo",
  "version": "1.0.0",
  "description": "ProfitSheets - Investment Made Simple. Full Stack Stock Screener & Trading Platform",
  "scripts": {
    "start": "node backend/index.js",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
