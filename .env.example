# ProfitSheets Environment Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Financial Data & Market News API Keys
FINNHUB_API_KEY=your_finnhub_api_key_here
KITE_API_KEY=your_kite_publisher_api_key_here
ANGEL_API_KEY=your_angel_one_smartapi_key_here

# Database Connection (MongoDB Atlas for Production / Vercel)
# If omitted, ProfitSheets automatically uses its resilient zero-config fallback store.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/profitsheets?retryWrites=true&w=majority

# Optional: EODHD 10-Year Fundamentals API Key
EODHD_API_KEY=your_eodhd_api_key_here
